build/
__pycache__/
*.o
*.dSYM/

# Diagnostics dumped by `schoolwifi diagnose`. These hold the portal's raw HTML
# and JavaScript, and the captured URLs carry the machine's IP and MAC, so they
# must never be committed.
schoolwifi-diagnose-*/
schoolwifi-portal-*.html

# Local configuration may contain a username (and, if the Keychain is not
# used, a password).
config/config.ini
*.local.ini

.DS_Store
